{
  "expo": {
    "name": "Coco Love",
    "slug": "cocolove-orders",
    "scheme": "cocolove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#120C14",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cocolove.orders",
      "infoPlist": {
        "NSCameraUsageDescription": "نستخدم الكاميرا لمسح باركود الإيصال والتحقق من حالة الدفع عند التسليم.",
        "NSFaceIDUsageDescription": "لقفل التطبيق بالبصمة أو بالوجه.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleLocalizations": [
          "ar",
          "fr",
          "en"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.cocolove.orders",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1422"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Tajawal_400Regular.ttf",
            "./assets/fonts/Tajawal_500Medium.ttf",
            "./assets/fonts/Tajawal_700Bold.ttf",
            "./assets/fonts/Tajawal_800ExtraBold.ttf",
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "للسماح بمسح باركود الإيصالات."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF6A",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#120C14"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
