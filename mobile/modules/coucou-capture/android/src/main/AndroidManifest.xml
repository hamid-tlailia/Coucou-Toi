<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!-- Reads customer messages from WhatsApp / Instagram / Messenger / TikTok notifications (opt-in, granted in system settings). -->
    <service
      android:name="expo.modules.coucoucapture.MessageListenerService"
      android:label="Coucou Toi"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Quick-settings tile: sends the copied message for analysis without leaving the chat. -->
    <service
      android:name="expo.modules.coucoucapture.CaptureTileService"
      android:label="Coucou Toi"
      android:icon="@drawable/coucou_capture_tile"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!-- Invisible screen behind the tile; also listed in the text-selection menu. -->
    <activity
      android:name="expo.modules.coucoucapture.CaptureActivity"
      android:label="Coucou Toi"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:exported="true"
      android:excludeFromRecents="true"
      android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
  </application>
</manifest>
