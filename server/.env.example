# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/cocolove"

# --- Server ---
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:8081"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"

# --- Google Sign-In ---
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_WEB_CLIENT_ID=""

# --- Apple Sign-In / App Store Server API (In-App Purchases) ---
APPLE_BUNDLE_ID="com.cocolove.orders"
APPLE_PRIVATE_KEY_PATH="./secrets/AuthKey_XXXXXXXXXX.p8"
APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
APPLE_ENVIRONMENT="Sandbox" # "Sandbox" or "Production"

# --- Google Play Developer API (In-App Purchases) ---
GOOGLE_PLAY_PACKAGE_NAME="com.cocolove.orders"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON="./secrets/play-service-account.json"

# =============================================================
# AI Smart Seller — extracts orders from social media messages
# =============================================================

# Google Gemini 1.5 Flash — structured JSON extraction of orders from text/images.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Groq (Whisper Large v3) — Arabic voice note transcription.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# Meta app secret, used to verify the X-Hub-Signature-256 header on every
# WhatsApp/Instagram/Messenger webhook POST. Meta App dashboard → Settings → Basic.
META_APP_SECRET=""

# Verify tokens you choose yourself and enter in the Meta App webhook
# subscription form (Meta calls back with these to prove it's really you
# configuring the subscription — they are not secrets from Meta, you invent them).
WHATSAPP_VERIFY_TOKEN="choose-a-verify-token"
INSTAGRAM_VERIFY_TOKEN="choose-a-verify-token"
MESSENGER_VERIFY_TOKEN="choose-a-verify-token"

# TikTok webhook / messaging credentials — see TikTok's current API docs,
# the exact fields depend on which TikTok messaging product you're approved for.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
