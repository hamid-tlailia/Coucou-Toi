generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
  apple
}

enum PlanId {
  free
  starter
  growth
  business
}

enum BillingCycle {
  monthly
  yearly
}

enum OrderStatus {
  new
  processing
  shipped
  delivered
}

enum PayStatus {
  paid
  unpaid
  cod
}

enum OrderSource {
  whatsapp
  instagram
  facebook
  tiktok
  manual
}

enum PendingOrderStatus {
  pending
  approved
  rejected
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?       // null for OAuth-only accounts
  name          String
  store         String?
  provider      AuthProvider
  providerSub   String?       // Google `sub` / Apple `sub` — used to re-match on future sign-ins
  plan          PlanId        @default(free)
  cycle         BillingCycle  @default(monthly)
  quotaUsed     Int           @default(0)
  quotaResetAt  DateTime      @default(now())
  createdAt     DateTime      @default(now())

  orders          Order[]
  refreshTokens   RefreshToken[]
  subscriptions   Subscription[]
  channelAccounts ChannelAccount[]
  pendingOrders   PendingOrder[]

  @@index([providerSub])
}

// Links a merchant to the numbers/pages/accounts their customers message on
// (WhatsApp phone_number_id, Instagram/Facebook page id, TikTok app user id).
// Incoming webhooks are matched against this table to know which merchant
// a message belongs to.
model ChannelAccount {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     OrderSource
  externalId  String      // e.g. WhatsApp phone_number_id, FB/IG page id, TikTok open id
  accessToken String?     // per-channel token used to fetch media (voice notes / images)
  createdAt   DateTime    @default(now())

  @@unique([channel, externalId])
  @@index([userId])
}

// A draft order the AI pipeline extracted from an incoming social message,
// waiting for the merchant to review and approve it in the app. Approving
// one creates a real Order (with its own tracking code/barcode); rejecting
// one just closes it out — neither ever touches the merchant's quota until
// approved.
model PendingOrder {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          OrderSource
  customer        String?
  phone           String?
  city            String?
  address         String?
  items           String?
  total           Decimal?           @db.Decimal(10, 3)
  pay             PayStatus?
  rawText         String?            // original message text / voice transcript, shown to the admin for review
  mediaUrl        String?            // voice note or image the extraction was based on
  confidence      Float?             // AI extraction confidence, 0-1 — surfaced in the app so low-confidence drafts get a closer look
  status          PendingOrderStatus @default(pending)
  approvedOrderId String?            @unique
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?

  @@index([userId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique   // we store a hash, never the raw token
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?           // rotation chain — lets us detect reuse of a stolen token

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   String
  phone      String
  city       String?
  items      String?
  total      Decimal     @db.Decimal(10, 3) // TND has 3 decimal places (millimes)
  status     OrderStatus @default(new)
  pay        PayStatus   @default(unpaid)
  source     OrderSource @default(manual)
  code       String      @unique // tracking code encoded in the receipt QR
  date       DateTime    @default(now())
  idemKey    String?     // idempotency key from the client, dedupes retried creates

  @@unique([userId, idemKey])
  @@index([userId, date])
  @@index([code])
  @@index([userId, customer])
}

model Subscription {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PlanId
  cycle           BillingCycle
  platform        String       // "ios" | "android"
  originalTxnId   String       @unique // Apple originalTransactionId / Google orderId root
  latestTxnId     String
  status          String       // active | expired | grace_period | revoked
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
}
